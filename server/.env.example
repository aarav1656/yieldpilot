# Protocol Addresses (Movement Mainnet)
ECHELON_ADDRESS=0xc6bc659f1649553c1a3fa05d9727433dc03843baac29473c817d06d39e7621ba

# Pricing (in MOVE base units, 8 decimals)
# 0.01 MOVE = 1000000
SIGNAL_PRICE_OPTIMAL_YIELD=1000000
SIGNAL_PRICE_PROTOCOL_ANALYTICS=100000
SIGNAL_PRICE_RISK_ASSESSMENT=500000
